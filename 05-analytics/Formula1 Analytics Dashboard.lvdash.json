    {
      "name": "d795bddc",
      "displayName": "Dominant_drivers",
      "queryLines": [
        "with driver_metrics as\r\n",
        "(\r\n",
        "select driver_name, \r\n",
        "sum(race_starts) as race_starts,\r\n",
        "sum(total_points) as Points,\r\n",
        "sum(number_of_wins) as wins,\r\n",
        "sum(number_of_podiums) as podiums,\r\n",
        "sum(case when standing = 1 then 1 else 0 end) as total_championships\r\n",
        "from formula1.gold.v_driver_standing\r\n",
        "group by driver_name\r\n",
        "having total_championships > 1\r\n",
        ")\r\n",
        "select driver_name, race_starts, wins, podiums, total_championships,\r\n",
        "(total_championships * 100) + (wins * 10) + (podiums * 3) as greatness_score\r\n",
        "from driver_metrics\r\n",
        "order by greatness_score desc\r\n",
        "limit 10"
      ]
    },
    {
      "name": "5f568582",
      "displayName": "Dominant_constructors",
      "queryLines": [
        "with constructor_metrics as\r\n",
        "(\r\n",
        "select constructor_name, \r\n",
        "sum(race_starts) as race_starts,\r\n",
        "sum(total_points) as Points,\r\n",
        "sum(number_of_wins) as wins,\r\n",
        "sum(number_of_podiums) as podiums,\r\n",
        "sum(case when standing = 1 then 1 else 0 end) as total_championships\r\n",
        "from formula1.gold.v_constructor_standing\r\n",
        "group by constructor_name\r\n",
        "having total_championships > 1\r\n",
        ")\r\n",
        "select constructor_name, race_starts, wins, podiums, total_championships,\r\n",
        "(total_championships * 100) + (wins * 10) + (podiums * 3) as greatness_score\r\n",
        "from constructor_metrics\r\n",
        "order by greatness_score desc"
      ]
    }
  ],
